{
  "name": "legit-hair-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:api && npm run test:integration",
    "test:unit": "mocha --import=tsx --timeout 15000 'test/unit/**/*.test.ts'",
    "test:api": "mocha --import=tsx 'test/api/**/*.test.ts'",
    "test:integration": "mocha --import=tsx --timeout 20000 'test/integration/**/*.test.ts'",
    "migrate": "node --env-file=.env --import tsx src/db/migrate-cli.ts",
    "seed:test": "node --import tsx scripts/seed-test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "mocha": "12.0.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
